<Window x:Class="Rovo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Rovo.Models"
        Title="Rovo" Width="820" Height="790" MinWidth="660" MinHeight="620"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Rovo" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="A simple home for Robocopy." Foreground="{StaticResource MutedInk}" Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Background="White" BorderBrush="#DEE5E9" BorderThickness="1" CornerRadius="8" Padding="24">
                <StackPanel IsEnabled="{Binding IsIdle}">
                    <Label Content="_Source folder" Target="{Binding ElementName=SourcePath}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="SourcePath" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Source folder" />
                        <Button Grid.Column="1" Content="Browse…" Margin="10,0,0,0" Click="BrowseSource_Click" AutomationProperties.Name="Browse source folder" />
                    </Grid>
                    <Label Content="_Destination folder" Target="{Binding ElementName=DestinationPath}" Margin="0,18,0,0" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="DestinationPath" Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Destination folder" />
                        <Button Grid.Column="1" Content="Browse…" Margin="10,0,0,0" Click="BrowseDestination_Click" AutomationProperties.Name="Browse destination folder" />
                    </Grid>
                    <TextBlock Text="Copies new and changed files. Files only in the destination are kept."
                               Foreground="{StaticResource MutedInk}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <Label Content="S_ubfolders" Target="{Binding ElementName=SubfolderSelection}" />
                            <ComboBox x:Name="SubfolderSelection" SelectedValue="{Binding Subfolders}" SelectedValuePath="Tag" AutomationProperties.Name="Subfolders">
                                <ComboBoxItem Content="None" Tag="{x:Static models:SubfolderMode.None}" />
                                <ComboBoxItem Content="Nonempty subfolders" Tag="{x:Static models:SubfolderMode.NonEmpty}" />
                                <ComboBoxItem Content="All subfolders" Tag="{x:Static models:SubfolderMode.All}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <Label Content="_Retries" Target="{Binding ElementName=RetryCount}" />
                            <TextBox x:Name="RetryCount" Text="{Binding Retries, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Retries" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="_Delay (seconds)" Target="{Binding ElementName=RetryDelay}" />
                            <TextBox x:Name="RetryDelay" Text="{Binding RetryDelaySeconds, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Retry delay in seconds" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="{Binding ValidationError}" Foreground="#AB2F26" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                    <Button Content="_Start copy" Command="{Binding StartCommand}" Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}" FontWeight="SemiBold" />
                    <Button Content="_Cancel" Command="{Binding CancelCommand}" Margin="10,0,0,0" />
                </DockPanel>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <ProgressBar Height="3" Margin="0,10,0,0" IsIndeterminate="{Binding IsRunning}" Foreground="{StaticResource Accent}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>

            <Expander Grid.Row="4" Header="Copy output" IsExpanded="True" Margin="0,22,0,0">
                <StackPanel Margin="0,10,0,0">
                    <TextBox x:Name="OutputBox" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" Height="190"
                             FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextChanged="OutputBox_TextChanged" AutomationProperties.Name="Robocopy output" />
                    <TextBlock Text="Latest run · up to 10,000 lines" FontSize="12" Foreground="{StaticResource MutedInk}" Margin="0,6,0,0" />
                </StackPanel>
            </Expander>
        </Grid>
    </ScrollViewer>
</Window>
